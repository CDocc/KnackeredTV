<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:colorAccent">#3B82F6</item>
        <item name="android:colorPrimary">#0F0F1E</item>
        <item name="android:statusBarColor">#0F0F1E</item>
        <item name="android:navigationBarColor">#0F0F1E</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
    </style>
    <style name="AppDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#60A5FA</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
    </style>
</resources>
