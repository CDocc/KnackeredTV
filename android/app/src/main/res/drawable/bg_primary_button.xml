<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#60A5FA" android:endColor="#3B82F6" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#2563EB" android:endColor="#1D4ED8" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#60A5FA" android:endColor="#3B82F6" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#3B82F6" android:endColor="#2563EB" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
