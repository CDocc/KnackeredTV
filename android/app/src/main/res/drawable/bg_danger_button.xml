<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#40EF4444" />
            <stroke android:width="2dp" android:color="#F87171" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <solid android:color="#40EF4444" />
            <stroke android:width="1dp" android:color="#F87171" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#26EF4444" />
            <stroke android:width="1dp" android:color="#80F87171" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
