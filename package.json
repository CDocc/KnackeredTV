{
  "name": "knackeredtv",
  "version": "0.1.0",
  "description": "Modern IPTV player for Windows - Electron + React + TypeScript + Tailwind",
  "main": "dist/main/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node dev.js",
    "build": "webpack --mode production",
    "start": "electron dist/main/main.cjs",
    "pack": "electron-builder --publish never",
    "dist": "npm run build && electron-builder"
  },
  "keywords": [
    "iptv",
    "player",
    "electron",
    "react"
  ],
  "author": "KnackeredTV",
  "license": "MIT",
  "build": {
    "appId": "com.knackeredtv.app",
    "productName": "KnackeredTV",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.LICENSE.txt"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/knfav.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "KnackeredTV-Installer-${version}.exe"
    },
    "portable": {
      "artifactName": "KnackeredTV-Portable-${version}.exe"
    }
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "css-loader": "^7.1.5",
    "electron": "^44.8.0",
    "electron-builder": "^26.18.0",
    "html-webpack-plugin": "^5.6.8",
    "postcss": "^8.5.30",
    "postcss-loader": "^8.2.1",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.3.6",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.4.4",
    "typescript": "^5.3.3",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "crypto-js": "^4.2.0",
    "dotenv": "^18.0.8",
    "ffmpeg-static": "^5.3.0",
    "hls.js": "^1.7.3",
    "m3u8-parser": "^7.2.0",
    "mpegts.js": "^1.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
